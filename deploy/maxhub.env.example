# Copiar para /opt/maxhub/.env.production (dono maxhub, chmod 600) e preencher.
# NUNCA colocar este arquivo preenchido no GitHub.

# ---------- banco (Postgres no próprio servidor) ----------
DATABASE_URL=postgres://maxhub:SENHA_DO_BANCO@127.0.0.1:5432/maxhub
# conexões simultâneas com o banco (padrão 10)
# DATABASE_POOL_MAX=10

# ---------- anexos (fotos, notas fiscais, PDFs) ----------
STORAGE_DIR=/var/lib/maxhub/arquivos

# ---------- sessão ----------
# o MESMO valor que está hoje na Vercel (assim ninguém precisa entrar de novo).
# Novo? gere com:  openssl rand -base64 48
SESSION_SECRET=

# endereço interno do próprio sistema (o filtro de entrada consulta por aqui)
MAXHUB_INTERNAL_URL=http://127.0.0.1:880

# ---------- Max (assistente) e cerca de localização ----------
# copiar da Vercel: MAX_LLM_API_KEY, MAX_LLM_BASE_URL, MAX_LLM_MODEL e as GEO_* que existirem
MAX_LLM_API_KEY=
MAX_LLM_BASE_URL=
MAX_LLM_MODEL=

# NÃO usar no servidor próprio (são da Vercel/Supabase):
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
